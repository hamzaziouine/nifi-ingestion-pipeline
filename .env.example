# Copy to .env and change every value marked change-me. .env is git-ignored.

# MySQL. The flow's DBCP service connects as user "nifi"; keep MYSQL_USER=nifi
# unless you also change "Database User" in the "MySQL nifi_test" controller service.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=nifi_test
MYSQL_USER=nifi
MYSQL_PASSWORD=change-me-nifi
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081

# MinIO admin account (console at http://localhost:9001)
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-admin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket and the restricted credentials NiFi uses to write Parquet files.
# Put these two values in the cle_acces_minio / cle_secrete_minio parameters.
S3_BUCKET=bronze
NIFI_S3_ACCESS_KEY=nifi-writer
NIFI_S3_SECRET_KEY=change-me-nifi-writer
